# Public checkout URL used by every buy button.
# If omitted, buttons fall back to the offer section so the page is never broken.
NEXT_PUBLIC_CHECKOUT_URL=https://your-checkout-provider.com/the-limitless-black-book

# Optional. Shows the Black Friday countdown only when this is a valid ISO date.
# Use a full ISO 8601 timestamp with an explicit time zone.
NEXT_PUBLIC_SALE_END=2026-11-30T23:59:59-05:00

# Optional. Set to true to add robots noindex and disallow crawling.
NEXT_PUBLIC_NOINDEX=false

# Optional but recommended. Used for metadata, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://thelimitlessblackbook.com
